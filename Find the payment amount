import java.util.Scanner;

public class ElectricityBill {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double units = sc.nextDouble(); // input units (int/float)

        double bill = 0;

        // Calculate bill according to slab rates
        if (units <= 50) {
            bill = units * 1;
        } else if (units <= 150) {
            bill = 50 * 1 + (units - 50) * 2;
        } else if (units <= 250) {
            bill = 50 * 1 + 100 * 2 + (units - 150) * 3;
        } else {
            bill = 50 * 1 + 100 * 2 + 100 * 3 + (units - 250) * 4;
        }

        // Apply 20% surcharge if bill > 150
        if (bill > 150) {
            bill += bill * 0.2;
        }

        // Print as integer
        System.out.println((int) bill);
    }
}
